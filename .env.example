# ── Database ─────────────────────────────────────────────────────────────────
# Supabase Postgres connection string.
#   Supabase dashboard → Settings → Database → Connection string.
#   • Local dev / Streamlit Cloud: the "Direct connection" string works.
#   • GitHub Actions: use the "Connection pooling" (Session pooler) string,
#     because Actions runners need an IPv4 endpoint. It looks like:
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# If DATABASE_URL is unset, the app falls back to a local SQLite file (data/jobs.db).
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ── Email summary (optional) ─────────────────────────────────────────────────
EMAIL_FROM=
EMAIL_TO=
EMAIL_PASSWORD=

# ── LinkedIn full descriptions (optional) ────────────────────────────────────
LI_AT_COOKIE=
